# Bootstrap instructions:
#
# 1. Generate any-sync configs:
#      git clone https://github.com/anyproto/any-sync-dockercompose.git
#      cd any-sync-dockercompose
#      echo 'EXTERNAL_LISTEN_HOSTS=anytype.guilhermebelchior.com' > .env.override
#      make generate
#
# 2. The generated ./etc/ directory contains:
#      any-sync-coordinator.yml, any-sync-consensusnode.yml,
#      any-sync-node.yml, any-sync-filenode.yml, client.yml
#
# 3. Adapt the generated configs for Kubernetes:
#    Replace Docker Compose service hostnames with K8s Service names:
#      any-sync-coordinator  → coordinator
#      any-sync-consensusnode → consensusnode
#      any-sync-node-1       → node
#      any-sync-filenode     → filenode
#      mongo-1               → mongodb-0.mongodb
#      redis                 → redis
#      minio                 → minio
#    Also update listenAddrs ports to match what's in the Kubernetes manifests:
#      coordinator: 33010 (TCP), 33020 (UDP)
#      consensusnode: 33013 (TCP), 33023 (UDP)
#      node: 33011 (TCP), 33021 (UDP)
#      filenode: 33012 (TCP), 33022 (UDP)
#
# 4. Fill in the template below with the adapted content, then encrypt:
#      cp secret.yaml.template secret.yaml
#      # edit secret.yaml with your values
#      sops -e secret.yaml > secret.enc.yaml
#      rm secret.yaml
#
# 5. Also update configmap-client.yaml with the content of ./etc/client.yml
#
apiVersion: v1
kind: Secret
metadata:
  name: anytype-configs
  namespace: anytype
stringData:
  MONGO_PASSWORD: "CHANGE_ME_strong_password"
  MINIO_ACCESS_KEY: "CHANGE_ME_access_key"
  MINIO_SECRET_KEY: "CHANGE_ME_secret_key"

  # Paste adapted content of ./etc/any-sync-coordinator.yml here
  any-sync-coordinator.yml: |
    drpc:
      listenAddrs:
        - 0.0.0.0:33010
      quic:
        listenAddrs:
          - 0.0.0.0:33020
    account:
      peerId: "GENERATED_COORDINATOR_PEER_ID"
      signingKey: "GENERATED_COORDINATOR_SIGNING_KEY"
      encryptionKey: "GENERATED_COORDINATOR_ENCRYPTION_KEY"
    networkStorePath: /storage/coordinator
    network:
      id: "GENERATED_NETWORK_ID"
      nodes:
        - peerId: "GENERATED_COORDINATOR_PEER_ID"
          addresses:
            - anytype.guilhermebelchior.com:33010
          types:
            - coordinator
        - peerId: "GENERATED_CONSENSUS_PEER_ID"
          addresses:
            - consensusnode:33013
          types:
            - consensus
        - peerId: "GENERATED_NODE_PEER_ID"
          addresses:
            - node:33011
          types:
            - tree
        - peerId: "GENERATED_FILENODE_PEER_ID"
          addresses:
            - filenode:33012
          types:
            - file
    mongo:
      connect: "mongodb://root:CHANGE_ME_strong_password@mongodb-0.mongodb:27017/coordinator?replicaSet=rs0&authSource=admin"
      database: coordinator
    nodeConf:
      defaultLimit: 1073741824
      spacesLimit: 1000

  # Paste adapted content of ./etc/any-sync-consensusnode.yml here
  any-sync-consensusnode.yml: |
    drpc:
      listenAddrs:
        - 0.0.0.0:33013
      quic:
        listenAddrs:
          - 0.0.0.0:33023
    account:
      peerId: "GENERATED_CONSENSUS_PEER_ID"
      signingKey: "GENERATED_CONSENSUS_SIGNING_KEY"
      encryptionKey: "GENERATED_CONSENSUS_ENCRYPTION_KEY"
    networkStorePath: /storage/consensus
    network:
      id: "GENERATED_NETWORK_ID"
      nodes:
        - peerId: "GENERATED_COORDINATOR_PEER_ID"
          addresses:
            - coordinator:33010
          types:
            - coordinator
        - peerId: "GENERATED_CONSENSUS_PEER_ID"
          addresses:
            - anytype.guilhermebelchior.com:33013
          types:
            - consensus
        - peerId: "GENERATED_NODE_PEER_ID"
          addresses:
            - node:33011
          types:
            - tree
        - peerId: "GENERATED_FILENODE_PEER_ID"
          addresses:
            - filenode:33012
          types:
            - file
    mongo:
      connect: "mongodb://root:CHANGE_ME_strong_password@mongodb-0.mongodb:27017/consensus?replicaSet=rs0&authSource=admin"
      database: consensus

  # Paste adapted content of ./etc/any-sync-node.yml here
  any-sync-node.yml: |
    drpc:
      listenAddrs:
        - 0.0.0.0:33011
      quic:
        listenAddrs:
          - 0.0.0.0:33021
    account:
      peerId: "GENERATED_NODE_PEER_ID"
      signingKey: "GENERATED_NODE_SIGNING_KEY"
      encryptionKey: "GENERATED_NODE_ENCRYPTION_KEY"
    storage:
      path: /storage
    network:
      id: "GENERATED_NETWORK_ID"
      nodes:
        - peerId: "GENERATED_COORDINATOR_PEER_ID"
          addresses:
            - coordinator:33010
          types:
            - coordinator
        - peerId: "GENERATED_CONSENSUS_PEER_ID"
          addresses:
            - consensusnode:33013
          types:
            - consensus
        - peerId: "GENERATED_NODE_PEER_ID"
          addresses:
            - anytype.guilhermebelchior.com:33011
          types:
            - tree
        - peerId: "GENERATED_FILENODE_PEER_ID"
          addresses:
            - filenode:33012
          types:
            - file

  # Paste adapted content of ./etc/any-sync-filenode.yml here
  any-sync-filenode.yml: |
    drpc:
      listenAddrs:
        - 0.0.0.0:33012
      quic:
        listenAddrs:
          - 0.0.0.0:33022
    account:
      peerId: "GENERATED_FILENODE_PEER_ID"
      signingKey: "GENERATED_FILENODE_SIGNING_KEY"
      encryptionKey: "GENERATED_FILENODE_ENCRYPTION_KEY"
    s3Store:
      endpoint: http://minio:9000
      bucket: anytype
      accessKey: "CHANGE_ME_access_key"
      secretKey: "CHANGE_ME_secret_key"
      region: us-east-1
    redis:
      url: redis://redis:6379
    network:
      id: "GENERATED_NETWORK_ID"
      nodes:
        - peerId: "GENERATED_COORDINATOR_PEER_ID"
          addresses:
            - coordinator:33010
          types:
            - coordinator
        - peerId: "GENERATED_CONSENSUS_PEER_ID"
          addresses:
            - consensusnode:33013
          types:
            - consensus
        - peerId: "GENERATED_NODE_PEER_ID"
          addresses:
            - node:33011
          types:
            - tree
        - peerId: "GENERATED_FILENODE_PEER_ID"
          addresses:
            - anytype.guilhermebelchior.com:33012
          types:
            - file
